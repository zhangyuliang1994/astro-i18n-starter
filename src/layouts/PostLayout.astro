---
import Base from "@/layouts/Base.astro";
import { Image } from "astro:assets";
import AvatarImage from "@/assets/about-avatar.png";
import { type Lang } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getTraditionalDateLabel } from "@/utils/lunar";
import { GITHUB_ACCOUNT, GITHUB_URL } from "@/consts";

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  category?: string;
  tags?: string[];
  cover?: any;
  headings?: { depth: number; slug: string; text: string }[];
  readingTime?: string;
}

const {
  title,
  description,
  pubDate,
  category,
  tags,
  cover,
  headings = [],
  readingTime,
} = Astro.props;

const locale = Astro.currentLocale as Lang;
const isEn = locale === "en";

const traditionalDate = getTraditionalDateLabel(pubDate, isEn);

const filteredHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<Base {title} {description} isArticle={true}>
  <div class="mx-auto max-w-[1120px] py-4 sm:py-6">
    <div class="grid grid-cols-1 gap-12 xl:grid-cols-[minmax(0,740px)_250px]">
      
      <!-- Left main reading column (740px golden reading width) -->
      <main class="min-w-0">
        <!-- 1. Top Meta Row -->
        <div class="mb-3.5 flex flex-wrap items-center gap-2.5 font-mono-tabular text-[13.5px] text-[var(--text-muted)]">
          <a href={getRelativeLocaleUrl(locale, "/blog")} class="inline-flex items-center gap-1 text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">
            <span>←</span>
            <span>{isEn ? "Blog" : "返回博客"}</span>
          </a>
          <span class="text-[var(--border-strong)]">/</span>
          <time datetime={pubDate.toISOString()} class="flex items-center gap-1.5">
            <span>{traditionalDate}</span>
          </time>
          {category && (
            <>
              <span class="text-[var(--border-strong)]">·</span>
              <a href={getRelativeLocaleUrl(locale, `/categories/${category}/`)} class="text-[var(--accent)] hover:underline">
                #{category}
              </a>
            </>
          )}
          {readingTime && (
            <>
              <span class="text-[var(--border-strong)]">·</span>
              <span>{readingTime}</span>
            </>
          )}
        </div>

        <!-- 2. H1 Title -->
        <h1 class:list={[
          "mb-6 text-[27px] sm:text-[34px] font-bold leading-[1.38] text-[var(--text-primary)]",
          isEn ? "font-serif tracking-tight" : "font-title tracking-wide"
        ]}>
          {title}
        </h1>

        <!-- 3. Abstract Callout Box -->
        {description && (
          <blockquote class="mb-8 rounded-r-md border-l-[3px] border-[var(--accent)] bg-[var(--bg-muted)] px-5 py-4 text-[15.5px] leading-[1.78] text-[var(--text-secondary)] shadow-sm">
            {description}
          </blockquote>
        )}

        <!-- Mobile Collapsible Table of Contents (< 1280px) -->
        {filteredHeadings.length > 0 && (
          <details class="xl:hidden mb-8 rounded-lg border border-[var(--border)] bg-[var(--bg-surface)] p-3.5 text-sm">
            <summary class="cursor-pointer font-medium text-[var(--text-primary)] flex items-center justify-between list-none">
              <span class="flex items-center gap-2">
                <span class="material-icons-sharp text-[1.1em] text-[var(--accent)]">toc</span>
                <span>{isEn ? "Table of Contents" : "文章目录"}</span>
              </span>
              <span class="text-xs text-[var(--text-muted)] font-mono-tabular">({filteredHeadings.length})</span>
            </summary>
            <ul class="mt-3 space-y-2 border-t border-[var(--border)] pt-3 text-[14px] text-[var(--text-secondary)]">
              {filteredHeadings.map((h) => (
                <li class={h.depth === 3 ? "pl-3 text-[13px] text-[var(--text-muted)]" : ""}>
                  <a href={`#${h.slug}`} class="block hover:text-[var(--accent)] transition-colors line-clamp-1">
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )}

        <!-- 4. 16:9 Cover Image -->
        {cover && (
          <figure class="my-8 overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--bg-muted)]">
            <Image
              src={cover}
              alt={title}
              width={1200}
              height={675}
              loading="eager"
              fetchpriority="high"
              class="aspect-[16/9] w-full object-cover"
            />
          </figure>
        )}

        <!-- 5. MDX Article Body -->
        <article class="prose-custom max-w-none text-[var(--text-primary)]">
          <slot />
        </article>

        <!-- Tags List -->
        {tags && tags.length > 0 && (
          <div class="mt-10 pt-6 border-t border-[var(--border)] flex flex-wrap items-center gap-2 font-mono-tabular text-xs">
            <span class="text-[var(--text-muted)]">{isEn ? "Tags:" : "标签："}</span>
            {tags.map((tag) => (
              <a
                href={getRelativeLocaleUrl(locale, `/tags/${tag}/`)}
                class="rounded bg-[var(--bg-muted)] px-2.5 py-1 text-[var(--text-secondary)] hover:bg-[var(--accent-subtle)] hover:text-[var(--accent)] transition-colors"
              >
                #{tag}
              </a>
            ))}
          </div>
        )}

        <!-- Author Signature Card -->
        <div class="mt-12 rounded-[var(--radius)] border border-[var(--border)] bg-[var(--bg-surface)] p-6 shadow-sm">
          <div class="flex items-center gap-4">
            <Image
              src={AvatarImage}
              alt="Frency"
              width={56}
              height={56}
              class="h-14 w-14 rounded-full border border-[var(--border)] object-cover flex-shrink-0"
            />
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <h3 class="text-base font-bold text-[var(--text-primary)]">Frency</h3>
                {!isEn && <span class="seal-stamp text-[11px]">晓风</span>}
                <span class="text-xs font-mono-tabular text-[var(--text-muted)]">· @{GITHUB_ACCOUNT}</span>
              </div>
              <p class="mt-1 text-sm text-[var(--text-secondary)] line-clamp-2">
                {isEn
                  ? "Backend engineer, building indie SaaS tools and digital gardens in public."
                  : "后端工程师，独立开发者。在这里记录技术探索、出海心得与生活切片。"}
              </p>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-[var(--border)] flex items-center justify-between text-xs font-mono-tabular text-[var(--text-muted)]">
            <div class="flex items-center gap-3">
              <a href={`/${locale}/rss.xml`} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--accent)] transition-colors">RSS</a>
              <span>·</span>
              <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--accent)] transition-colors">GitHub</a>
              <span>·</span>
              <a href={getRelativeLocaleUrl(locale, "/about")} class="hover:text-[var(--accent)] transition-colors">{isEn ? "About" : "关于我"}</a>
            </div>
            <a href={getRelativeLocaleUrl(locale, "/ask")} class="text-[var(--accent)] font-semibold hover:underline">
              {isEn ? "Ask me anything →" : "向我提问 (AI) →"}
            </a>
          </div>
        </div>

      </main>

      <!-- Right Sticky TOC Column (>= 1280px) -->
      <aside class="hidden xl:block">
        <div class="sticky top-24 border-l border-[var(--border)] pl-5">
          <h4 class="mb-3 font-mono-tabular text-[12.5px] font-semibold uppercase tracking-wider text-[var(--text-muted)]">
            {isEn ? "On This Page" : "本页目录"}
          </h4>
          {filteredHeadings.length > 0 ? (
            <ul class="space-y-2.5 text-[13.5px] text-[var(--text-secondary)] max-h-[calc(100vh-140px)] overflow-y-auto pr-2">
              {filteredHeadings.map((h) => (
                <li class={h.depth === 3 ? "pl-3 text-[13px] text-[var(--text-muted)]" : ""}>
                  <a
                    href={`#${h.slug}`}
                    class="block hover:text-[var(--accent)] transition-colors line-clamp-1"
                    title={h.text}
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-xs text-[var(--text-muted)]">{isEn ? "No subheadings" : "暂无小节"}</p>
          )}
        </div>
      </aside>

    </div>
  </div>
</Base>

<script>
  import mediumZoom from 'medium-zoom';
  const initZoom = () => {
    const isDark = document.documentElement.dataset.theme === 'dark' || document.documentElement.classList.contains('dark');
    mediumZoom('.prose-custom img, .article-shell img', {
      margin: 24,
      background: isDark ? 'rgba(20, 20, 19, 0.94)' : 'rgba(250, 248, 245, 0.94)',
    });
  };
  initZoom();
  document.addEventListener('astro:page-load', initZoom);
</script>
