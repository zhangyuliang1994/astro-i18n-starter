---
import Base from "@/layouts/Base.astro";
import BackToTop from "@/components/BackToTop.astro";

interface Props { title?: string; description?: string; frontmatter?: undefined; }
const { title, description } = Astro.props.frontmatter || Astro.props;
---

<Base {title} {description}>
  <article class="article-shell"><slot /></article>
  <BackToTop />
</Base>

<style>
  .article-shell {
    width: 100%;
    max-width: var(--reading);
    margin-inline: auto;
    padding: clamp(30px, 4.5vw, 52px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface-high);
    font-size: 1.075rem;
    line-height: 1.8;
    overflow-wrap: break-word;
  }
  .article-shell > :global(*) { min-width: 0; margin-block: 1.35em 0; margin-inline: 0; }
  .article-shell > :global(:first-child) { margin-top: 0; }
  .article-shell :global(p) { color: var(--color-main); font-weight: 400; }
  .article-shell :global(h2) { margin-block: 2.8em 0; padding-block-end: 0.35em; border-bottom: 1px solid var(--color-border); font-size: clamp(1.5rem, 2.5vw, 1.75rem); }
  .article-shell :global(h3) { margin-block: 2.2em 0; font-size: clamp(1.25rem, 2vw, 1.4rem); }
  .article-shell :global(h4) { margin-block: 2em -0.4em; font-size: 1.1rem; }
  .article-shell :global(ul) { list-style: disc; padding-inline-start: 1.5em; }
  .article-shell :global(ol) { list-style: decimal; padding-inline-start: 1.5em; }
  .article-shell :global(li) { margin-block-end: 0.55em; }
  .article-shell :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    table-layout: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    font-size: 0.92em;
  }
  .article-shell :global(th),
  .article-shell :global(td) {
    min-width: 120px;
    padding: 0.65em 0.8em;
    border: 1px solid var(--color-border);
    vertical-align: top;
  }
  .article-shell :global(th) {
    background: var(--color-code);
    text-align: start;
    white-space: nowrap;
  }
  .article-shell :global(strong) { text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--color-theme) 35%, transparent); text-decoration-thickness: 0.2em; text-underline-offset: -0.05em; }
  .article-shell :global(:not(pre) > code) { padding: 0.2em 0.4em; border-radius: 4px; background: var(--color-code); color: var(--color-theme); font-family: var(--font-mono); font-size: 0.9em; overflow-wrap: anywhere; word-break: break-word; white-space: normal; }
  .article-shell :global(pre) { max-width: 100%; overflow-x: auto; overscroll-behavior-inline: contain; padding: 1.1em; border: 1px solid var(--color-border-strong); border-radius: var(--radius-small); background: var(--color-code) !important; font-family: var(--font-mono); font-size: 0.88rem; line-height: 1.65; -webkit-overflow-scrolling: touch; }
  .article-shell :global(pre code) { overflow-wrap: normal; word-break: normal; white-space: pre; }
  .article-shell :global(blockquote) { padding: 1.1em 1.25em; border-inline-start: 3px solid var(--color-theme); background: var(--color-code); color: var(--color-muted); }
  .article-shell :global(blockquote p:first-child) { margin-top: 0; }
  .article-shell :global(blockquote p:last-child) { margin-bottom: 0; }
  .article-shell :global(hr) { margin-block: 4em 3em; border: 0; border-top: 1px solid var(--color-border); }
  .article-shell :global(a) { color: var(--color-theme); text-decoration: underline; text-underline-offset: 0.18em; overflow-wrap: anywhere; }
  .article-shell :global(img),
  .article-shell :global(video) { display: block; max-width: 100%; height: auto; margin-inline: auto; border-radius: var(--radius-small); background: var(--color-code); }
  .article-shell :global(iframe) { max-width: 100%; }
  .article-shell :global(iframe[src*="youtube"]),
  .article-shell :global(iframe[src*="vimeo"]) { width: 100%; height: auto; aspect-ratio: 16 / 9; border-radius: var(--radius-small); }
  .article-shell :global(figure) { max-width: 100%; }
  .article-shell :global(figcaption) { margin-top: 0.75em; color: var(--color-muted); font-size: 0.86em; text-align: center; }
  .article-shell :global(details) { padding: 16px; border: 1px solid var(--color-border); border-radius: var(--radius-small); background: var(--color-surface); }
  .article-shell :global(summary) { min-height: 44px; cursor: pointer; font-weight: 600; }
  @media (max-width: 640px) {
    .article-shell { padding: 24px 18px; border-radius: 10px; font-size: 1.03rem; line-height: 1.75; }
    .article-shell :global(h2) { margin-top: 2.35em; font-size: 1.45rem; }
    .article-shell :global(h3) { margin-top: 1.9em; font-size: 1.25rem; }
    .article-shell :global(blockquote) { padding: 1em; }
    .article-shell :global(th),
    .article-shell :global(td) { min-width: 112px; padding: 0.6em 0.7em; }
  }
</style>
