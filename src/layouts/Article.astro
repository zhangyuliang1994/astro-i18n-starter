---
import Base from "@/layouts/Base.astro";

interface Props {
  title?: string;
  description?: string;
  frontmatter?: undefined;
}
const { title, description } = Astro.props.frontmatter || Astro.props;
---

<Base {title} {description} isArticle={true}>
  <article class="article-shell"><slot /></article>
</Base>

<script>
  import mediumZoom from 'medium-zoom';
  const initZoom = () => {
    const isDark = document.documentElement.dataset.theme === 'dark' || document.documentElement.classList.contains('dark');
    mediumZoom('.article-shell img', {
      margin: 24,
      background: isDark ? 'rgba(20, 20, 19, 0.94)' : 'rgba(250, 248, 245, 0.94)',
    });
  };
  initZoom();
  document.addEventListener('astro:page-load', initZoom);
</script>

<style>
  .article-shell {
    width: 100%;
    max-width: var(--reading, 1080px);
    margin-inline: auto;
    padding: clamp(28px, 4vw, 48px);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-surface);
    font-size: 1.0625rem;
    line-height: 1.8;
    overflow-wrap: break-word;
  }
  .article-shell > :global(*) { min-width: 0; margin-block: 1.35em 0; margin-inline: 0; }
  .article-shell > :global(:first-child) { margin-top: 0; }
  .article-shell :global(p) { color: var(--text-primary); font-weight: 400; }
  .article-shell :global(h2) { margin-block: 2.6em 0.8em; padding-block-end: 0.35em; border-bottom: 1px solid var(--border); font-size: clamp(1.4rem, 2.5vw, 1.75rem); color: var(--text-primary); font-weight: 700; }
  .article-shell :global(h3) { margin-block: 2em 0.6em; font-size: clamp(1.2rem, 2vw, 1.35rem); color: var(--text-primary); font-weight: 700; }
  .article-shell :global(h4) { margin-block: 1.6em 0.4em; font-size: 1.1rem; color: var(--text-primary); font-weight: 600; }
  .article-shell :global(ul) { list-style: disc; padding-inline-start: 1.5em; }
  .article-shell :global(ol) { list-style: decimal; padding-inline-start: 1.5em; }
  .article-shell :global(li) { margin-block-end: 0.55em; color: var(--text-secondary); }
  .article-shell :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    table-layout: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    font-size: 0.92em;
  }
  .article-shell :global(th),
  .article-shell :global(td) {
    min-width: 120px;
    padding: 0.65em 0.8em;
    border: 1px solid var(--border);
    vertical-align: top;
  }
  .article-shell :global(th) {
    background: var(--bg-muted);
    color: var(--text-primary);
    text-align: start;
    white-space: nowrap;
    font-weight: 600;
  }
  .article-shell :global(strong) { text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent); text-decoration-thickness: 0.2em; text-underline-offset: -0.05em; color: var(--text-primary); }
  .article-shell :global(:not(pre) > code) { padding: 0.2em 0.4em; border-radius: 4px; background: var(--bg-muted); color: var(--accent); font-family: var(--font-mono); font-size: 0.9em; overflow-wrap: anywhere; word-break: break-word; white-space: normal; }
  .article-shell :global(pre) { max-width: 100%; overflow-x: auto; overscroll-behavior-inline: contain; padding: 1.1em; border: 1px solid var(--border); border-radius: var(--radius-small); background: var(--bg-muted) !important; font-family: var(--font-mono); font-size: 0.88rem; line-height: 1.65; -webkit-overflow-scrolling: touch; }
  .article-shell :global(pre code) { overflow-wrap: normal; word-break: normal; white-space: pre; }
  .article-shell :global(blockquote) { padding: 1.1em 1.25em; border-inline-start: 3px solid var(--accent); background: var(--bg-muted); color: var(--text-secondary); border-radius: 0 var(--radius-small) var(--radius-small) 0; }
  .article-shell :global(blockquote p:first-child) { margin-top: 0; }
  .article-shell :global(blockquote p:last-child) { margin-bottom: 0; }
  .article-shell :global(hr) { margin-block: 3.5em 2.5em; border: 0; border-top: 1px solid var(--border); }
  .article-shell :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 0.18em; overflow-wrap: anywhere; }
  .article-shell :global(img),
  .article-shell :global(video) { display: block; max-width: 100%; height: auto; margin-inline: auto; border-radius: var(--radius-small); background: var(--bg-muted); cursor: zoom-in; }
  .article-shell :global(iframe) { max-width: 100%; }
  .article-shell :global(iframe[src*="youtube"]),
  .article-shell :global(iframe[src*="vimeo"]) { width: 100%; height: auto; aspect-ratio: 16 / 9; border-radius: var(--radius-small); }
  .article-shell :global(figure) { max-width: 100%; }
  .article-shell :global(figcaption) { margin-top: 0.75em; color: var(--text-muted); font-size: 0.86em; text-align: center; }
  .article-shell :global(details) { padding: 16px; border: 1px solid var(--border); border-radius: var(--radius-small); background: var(--bg-surface); }
  .article-shell :global(summary) { min-height: 44px; cursor: pointer; font-weight: 600; }
  @media (max-width: 640px) {
    .article-shell { padding: 22px 16px; border-radius: 10px; font-size: 1.02rem; line-height: 1.75; }
    .article-shell :global(h2) { margin-top: 2.2em; font-size: 1.4rem; }
    .article-shell :global(h3) { margin-top: 1.8em; font-size: 1.2rem; }
    .article-shell :global(blockquote) { padding: 1em; }
    .article-shell :global(th),
    .article-shell :global(td) { min-width: 112px; padding: 0.6em 0.7em; }
  }
</style>
