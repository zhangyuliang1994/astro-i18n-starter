---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { useTranslations, type Lang, getLocalePaths } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import { SITE_TITLE } from "@/consts";

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);
const path = Astro.url.pathname.replace(/^\/[a-zA-Z-]+/, "").replace(/\/$/, "") || "/";
const isActive = (href: string) => href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);

const isEn = locale === "en";
const targetLang = isEn ? "zh-cn" : "en";
const localePaths = getLocalePaths(Astro.url);
const targetLocalePath = localePaths.find((p) => p.lang === targetLang)?.path || (isEn ? "/zh-cn/" : "/en/");

const links = [
  { href: "/blog", label: t({ en: "Blog", "zh-cn": "博客", ja: "ブログ", ar: "مدونة" }) },
  { href: "/books", label: t({ en: "Reading", "zh-cn": "读书", ja: "本棚", ar: "كتب" }) },
  { href: "/projects", label: t({ en: "Projects", "zh-cn": "项目", ja: "プロジェクト", ar: "مشاريع" }) },
  { href: "/categories", label: t({ en: "Categories", "zh-cn": "分类", ja: "カテゴリー", ar: "التصنيفات" }) },
  { href: "/friends", label: t({ en: "Friends", "zh-cn": "友链", ja: "友達", ar: "أصدقاء" }) },
  { href: "/about", label: t({ en: "About", "zh-cn": "关于", ja: "約", ar: "حول" }) },
];

const menuLabel = t({ en: "Open navigation", "zh-cn": "打开导航", ja: "ナビゲーションを開く", ar: "فتح التنقل" });
---

<header class="site-header">
  <div class="header-inner">
    <!-- Brand -->
    <a class="brand" href={getRelativeLocaleUrl(locale, "/")} aria-label={t(SITE_TITLE)}>
      <span class="brand-seal" aria-hidden="true">{isEn ? "XF" : "晓风"}</span>
      <span class="brand-name">{t(SITE_TITLE)}</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Primary navigation">
      {links.map((link) => {
        const active = isActive(link.href);
        return (
          <a
            href={getRelativeLocaleUrl(locale, link.href)}
            class:list={[{ active }]}
            aria-current={active ? "page" : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Header Tools: Language Switcher Capsule & Theme Toggle -->
    <div class="header-tools">
      <a
        href={targetLocalePath}
        class="lang-pill"
        title={isEn ? "切换至中文" : "Switch to English"}
        aria-label={isEn ? "切换至中文" : "Switch to English"}
      >
        <span class:list={[{ active: !isEn }]}>中</span>
        <span class="sep">/</span>
        <span class:list={[{ active: isEn }]}>EN</span>
      </a>

      <ThemeToggle />

      <!-- Mobile menu trigger -->
      <details class="mobile-menu">
        <summary aria-label={menuLabel}>
          <span class="material-icons-sharp" aria-hidden="true">menu</span>
        </summary>
        <div class="mobile-panel">
          <nav aria-label="Mobile navigation">
            {links.map((link) => (
              <a
                href={getRelativeLocaleUrl(locale, link.href)}
                class:list={[{ active: isActive(link.href) }]}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            ))}
          </nav>
          <div class="mobile-tools">
            <a
              href={targetLocalePath}
              class="lang-pill mobile-lang-pill"
              title={isEn ? "切换至中文" : "Switch to English"}
            >
              <span class:list={[{ active: !isEn }]}>中</span>
              <span class="sep">/</span>
              <span class:list={[{ active: isEn }]}>EN</span>
            </a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-height);
    border-bottom: 1px solid var(--border);
    background-color: color-mix(in srgb, var(--bg-primary) 85%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .header-inner {
    max-width: var(--container-wide, 1160px);
    margin-inline: auto;
    padding-inline: var(--page-gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 16px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--text-primary);
  }

  .brand-seal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 2px;
    background: var(--accent);
    color: #FFFFFF;
    font-family: var(--font-title);
    font-size: 11.5px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 30%, transparent), 0 2px 4px rgba(185, 56, 38, 0.2);
    user-select: none;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .brand:hover .brand-seal {
    transform: rotate(-3deg) scale(1.05);
  }

  .brand-name {
    font-family: var(--font-interface);
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .desktop-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    font-size: 0.96875rem; /* 15.5px */
    font-weight: 500;
    color: var(--text-secondary);
    border-radius: var(--radius-small);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .desktop-nav a:hover {
    color: var(--text-primary);
    background: var(--bg-muted);
  }

  .desktop-nav a.active {
    color: var(--text-primary);
    font-weight: 600;
    background: var(--bg-muted);
  }

  .desktop-nav a.active::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 12px;
    right: 12px;
    height: 2px;
    border-radius: 9999px;
    background: var(--accent);
  }

  .header-tools {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .lang-pill {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 5px 12px;
    border-radius: 9999px;
    border: 1px solid var(--border);
    background: var(--bg-surface);
    font-family: var(--font-mono);
    font-size: 0.8125rem; /* 13px */
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    transition: all 0.2s ease;
  }

  .lang-pill:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-subtle);
  }

  .lang-pill span.active {
    color: var(--accent);
    font-weight: 700;
  }

  .lang-pill .sep {
    color: var(--text-muted);
    opacity: 0.6;
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 860px) {
    .desktop-nav {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
    .mobile-menu[open]::before {
      content: "";
      position: fixed;
      inset: var(--header-height) 0 0;
      z-index: -1;
      background: color-mix(in srgb, var(--text-primary) 18%, transparent);
    }
    .mobile-menu summary {
      display: grid;
      width: 40px;
      height: 40px;
      place-items: center;
      border-radius: var(--radius-small);
      border: 1px solid var(--border);
      background: var(--bg-surface);
      color: var(--text-secondary);
      cursor: pointer;
      list-style: none;
    }
    .mobile-menu summary::-webkit-details-marker {
      display: none;
    }
    .mobile-menu[open] summary {
      color: var(--accent);
      border-color: var(--accent);
    }
    .mobile-panel {
      position: absolute;
      top: var(--header-height);
      inset-inline: 0;
      width: 100%;
      max-height: calc(100dvh - var(--header-height));
      overflow-y: auto;
      padding: 16px var(--page-gutter) 24px;
      border-bottom: 1px solid var(--border);
      background: var(--bg-surface);
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
    }
    .mobile-panel nav {
      display: grid;
    }
    .mobile-panel nav a {
      display: flex;
      min-height: 44px;
      align-items: center;
      border-bottom: 1px solid var(--border);
      color: var(--text-secondary);
      font-weight: 600;
      font-size: 1rem;
      text-decoration: none;
    }
    .mobile-panel nav a.active {
      color: var(--accent);
    }
    .mobile-tools {
      margin-top: 16px;
      display: flex;
      justify-content: flex-end;
    }
  }
</style>
