---
import { Image } from "astro:assets";
import AvatarImage from "@/assets/about-avatar.png";
import { type Lang } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const isEn = locale === "en";
---

<section class="hero-section">
  <div class="mist-mountain-bg" aria-hidden="true">
    <svg viewBox="0 0 1200 420" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <filter id="inkBlur" x="-10%" y="-10%" width="120%" height="120%"><feGaussianBlur stdDeviation="3" /></filter>
        <filter id="inkBlurSoft"><feGaussianBlur stdDeviation="8" /></filter>
        <linearGradient id="inkFade" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="currentColor" stop-opacity="0.9" />
          <stop offset="1" stop-color="currentColor" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path d="M0 300 C120 250 190 210 280 240 C360 266 420 190 520 170 C610 152 660 230 760 210 C860 190 900 120 1000 140 C1090 158 1140 220 1200 230 L1200 420 L0 420Z" fill="url(#inkFade)" opacity="0.06" filter="url(#inkBlurSoft)" />
      <path d="M560 330 C640 280 700 230 780 250 C840 266 870 200 940 180 C1010 162 1060 240 1120 250 C1160 256 1185 270 1200 280 L1200 420 L560 420Z" fill="url(#inkFade)" opacity="0.09" filter="url(#inkBlur)" />
      <path d="M760 380 C820 340 870 320 930 330 C990 340 1030 290 1090 300 C1140 308 1170 330 1200 340 L1200 420 L760 420Z" fill="url(#inkFade)" opacity="0.13" filter="url(#inkBlur)" />
      <g stroke="currentColor" stroke-opacity="0.035" stroke-width="1">
        <line x1="640" y1="20" x2="610" y2="140" /><line x1="720" y1="0" x2="690" y2="120" /><line x1="820" y1="30" x2="790" y2="150" />
        <line x1="900" y1="10" x2="870" y2="130" /><line x1="1080" y1="20" x2="1050" y2="140" /><line x1="1160" y1="0" x2="1130" y2="120" />
      </g>
    </svg>
  </div>

  <div class="hero-container">
    <!-- Left column: Intro & Status -->
    <div class="hero-left">
      <div class="hero-author-row">
        <a href={getRelativeLocaleUrl(locale, "/about")} class="avatar-link" title={isEn ? "About Frency" : "关于作者"}>
          <Image
            src={AvatarImage}
            alt="Frency"
            width={76}
            height={76}
            class="hero-avatar"
            loading="eager"
            fetchpriority="high"
          />
        </a>

        <div class="hero-name-block">
          <div class="hero-greeting">
            <span class="greeting-prefix">{isEn ? "Hello, I'm" : "你好，我是"}</span>
            <span class="hero-name">{isEn ? "Frency" : "晓风"}</span>
            {!isEn && <span class="seal-stamp ml-1.5">字·小峰</span>}
          </div>
          <p class="hero-subtitle">
            {isEn ? "Backend Engineer · Indie Builder · Digital Gardener" : "后端工程师 · 独立出海 · 慢品烟雨与代码"}
          </p>
        </div>
      </div>

      <p class="hero-bio">
        {
          isEn ? (
            <>
              Welcome to my digital garden. Documenting backend system design, indie micro-SaaS explorations, SEO playbooks, and curated book takeaways from Nanjing.
            </>
          ) : (
            <>
              驻扎金陵的后端开发工程师，业余折腾出海工具与独立开发。在这里静心记录系统架构、出海复盘、技术笔记与读书感悟。
            </>
          )
        }
      </p>

      <!-- Meta Row -->
      <div class="hero-meta-row">
        <div class="hero-status">
          <span class="location-pill">
            <span class="status-pulse" aria-hidden="true"></span>
            金陵 · Nanjing
          </span>
          <span class="status-sep">·</span>
          <span class="reading-hint">
            {isEn ? "Reading " : "最近在读 "}
            <a href={getRelativeLocaleUrl(locale, "/books/the-road-less-traveled")} class="book-link">
              《{isEn ? "The Road Less Traveled" : "少有人走的路"}》
            </a>
          </span>
        </div>

        <div class="hero-links">
          <a href={getRelativeLocaleUrl(locale, "/rss.xml")} class="quick-link">RSS</a>
          <span class="link-sep">·</span>
          <a href="https://github.com/psephopaiktes" target="_blank" rel="noopener noreferrer" class="quick-link">GitHub</a>
          <span class="link-sep">·</span>
          <a href={getRelativeLocaleUrl(locale, "/ask")} class="quick-link ask-link">
            {isEn ? "Ask AI" : "AI 问答"} →
          </a>
        </div>
      </div>
    </div>

    <!-- Right column: Poetic vertical scroll (zh-cn) / Ex Libris (en) -->
    <div class="hero-right">
      {isEn ? (
        <div class="ex-libris-card">
          <div class="ex-libris-top">
            <span class="seal-stamp seal-solid text-xs">XF</span>
            <span class="ex-libris-title">DIGITAL GARDEN</span>
          </div>
          <p class="ex-libris-quote">
            “The slow craft of code and thought, cultivating clarity in the digital wilderness.”
          </p>
          <div class="ex-libris-bottom">
            <span>COLLECTION & NOTES</span>
            <span class="font-mono">EST. 2024</span>
          </div>
        </div>
      ) : (
        <div class="vertical-scroll-card">
          <div class="scroll-inner">
            <div class="vertical-verse">
              <span class="verse-line">烟雨入墨，</span>
              <span class="verse-line">慢煮光阴。</span>
              <span class="verse-line">潜心修码，</span>
              <span class="verse-line">且读且行。</span>
            </div>
            <div class="scroll-seal-col">
              <span class="seal-stamp seal-solid text-[12px]">晓风</span>
              <span class="seal-date">岁次丙午</span>
            </div>
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-block: clamp(48px, 6vw, 84px) clamp(56px, 6vw, 88px);
    border-bottom: 1px solid transparent;
    border-image: linear-gradient(90deg, transparent, color-mix(in srgb, var(--text-primary) 22%, transparent) 30%, color-mix(in srgb, var(--text-primary) 22%, transparent) 70%, transparent) 1;
    overflow: hidden;
  }

  .mist-mountain-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    color: var(--text-primary);
    -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent), linear-gradient(to right, transparent, #000 12%, #000 92%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to bottom, #000 70%, transparent), linear-gradient(to right, transparent, #000 12%, #000 92%, transparent);
    mask-composite: intersect;
    background: radial-gradient(circle at 80% 26%, color-mix(in srgb, var(--accent) 16%, transparent) 0 34px, transparent 60px);
  }
  .mist-mountain-bg svg { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 100%; display: block; }
  :root[data-theme="dark"] .mist-mountain-bg,
  html.dark .mist-mountain-bg { opacity: 0.8; }

  .hero-container {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: minmax(0, 1fr) 240px;
      gap: 48px;
    }
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .hero-author-row {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .avatar-link {
    display: inline-block;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .hero-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    object-fit: cover;
    box-shadow: 0 4px 12px rgba(35, 33, 30, 0.08);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }

  .avatar-link:hover .hero-avatar {
    transform: rotate(4deg) scale(1.05);
    box-shadow: 0 6px 16px color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .hero-name-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hero-greeting {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .greeting-prefix {
    font-size: 1.05rem;
    color: var(--text-muted);
  }

  .hero-name {
    font-family: var(--font-title);
    font-size: clamp(2.2rem, 4.4vw, 3.2rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  .hero-subtitle {
    margin: 4px 0 0;
    font-size: clamp(1.02rem, 1.5vw, 1.2rem);
    font-family: var(--font-title);
    letter-spacing: 0.08em;
    color: var(--text-muted);
    letter-spacing: -0.01em;
  }

  .hero-bio {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-secondary);
    max-width: 720px;
  }

  .hero-meta-row {
    margin-top: 6px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .hero-status {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .location-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border-radius: var(--radius-small);
    background: var(--bg-muted);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    font-weight: 500;
  }

  .status-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);
  }

  .status-sep,
  .link-sep {
    color: var(--border-strong);
  }

  .reading-hint {
    color: var(--text-muted);
  }

  .book-link {
    color: var(--text-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .book-link:hover {
    color: var(--accent);
  }

  .hero-links {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .quick-link {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .quick-link:hover {
    color: var(--accent);
  }

  .ask-link {
    color: var(--accent);
    font-weight: 600;
  }

  /* Right Column: Scholars' Vertical Verse Scroll */
  .hero-right {
    display: flex;
    justify-content: flex-end;
  }

  .vertical-scroll-card {
    display: inline-flex;
    padding: 8px 4px;
    background: none;
    border: 0;
    box-shadow: none;
  }

  .scroll-inner {
    display: flex;
    flex-direction: row-reverse;
    gap: 20px;
    align-items: stretch;
  }

  .vertical-verse {
    writing-mode: vertical-rl;
    text-orientation: upright;
    font-family: var(--font-title);
    font-size: 1.3rem;
    line-height: 2.2;
    letter-spacing: 0.24em;
    color: var(--text-primary);
  }

  .verse-line {
    display: block;
  }

  .scroll-seal-col {
    writing-mode: vertical-rl;
    text-orientation: upright;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 4px;
  }

  .seal-date {
    font-family: var(--font-title);
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.15em;
  }

  /* Ex Libris Card for English */
  .ex-libris-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    max-width: 260px;
    padding: 20px;
    border: 0;
    border-left: 1px solid color-mix(in srgb, var(--text-primary) 20%, transparent);
    background: none;
  }

  .ex-libris-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .ex-libris-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .ex-libris-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.3rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-block: 16px;
  }

  .ex-libris-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    border-top: 1px dashed var(--border);
    padding-top: 10px;
  }

  @media (max-width: 1023px) {
    .hero-right {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      padding-block: 24px 20px;
    }
    .hero-avatar {
      width: 54px;
      height: 54px;
    }
    .hero-meta-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    .hero-links {
      width: 100%;
      justify-content: flex-start;
    }
  }
</style>
