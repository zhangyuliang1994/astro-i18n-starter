---
import { Image } from "astro:assets";
import AvatarImage from "@/assets/about-avatar.png";
import { type Lang } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const isEn = locale === "en";
---

<section class="hero-section">
  <div class="hero-card">
    <div class="hero-main-content">
      <!-- Row 1: Avatar + Greeting -->
      <div class="hero-header">
        <a href={getRelativeLocaleUrl(locale, "/about")} class="avatar-link" title={isEn ? "About Frency" : "关于作者"}>
          <Image
            src={AvatarImage}
            alt="Frency"
            width={92}
            height={92}
            class="hero-avatar"
            loading="eager"
            fetchpriority="high"
          />
        </a>
        <h1 class="hero-title">
          Hi, I'm Frency<span class="dot">.</span>
        </h1>
      </div>

      <!-- Row 2: Bio -->
      <p class="hero-bio">
        {
          isEn ? (
            <>
              Backend engineer based in Nanjing, building global SEO tools and indie products. Welcome to my{" "}
              <span class="garden-badge">digital garden</span> of engineering insights, reading notes, and building in public.
            </>
          ) : (
            <>
              驻扎南京的后端工程师，业余折腾出海 SEO 工具与独立游戏站。这里是我记录技术演进、读书笔记与生活切片的{" "}
              <span class="garden-badge">数字花园</span>。
            </>
          )
        }
      </p>

      <!-- Row 3: Meta & Status Row -->
      <div class="hero-meta-row">
        <div class="hero-status">
          <span class="location-pill">
            <span class="status-pulse" aria-hidden="true"></span>
            Nanjing, CN
          </span>
          <span class="status-sep">·</span>
          <span class="reading-hint">
            {isEn ? "Recently reading " : "最近在读 "}
            <a href={getRelativeLocaleUrl(locale, "/books/the-road-less-traveled")} class="book-link">
              《{isEn ? "The Road Less Traveled" : "少有人走的路"}》
            </a>
          </span>
        </div>

        <div class="hero-links">
          <a href={getRelativeLocaleUrl(locale, "/rss.xml")} class="quick-link">RSS</a>
          <span class="link-sep">·</span>
          <a href="https://github.com/psephopaiktes" target="_blank" rel="noopener noreferrer" class="quick-link">GitHub</a>
          <span class="link-sep">·</span>
          <a href={getRelativeLocaleUrl(locale, "/ask")} class="quick-link ask-link">
            {isEn ? "Ask AI" : "AI 问答"} →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-block: 40px 32px;
    border-bottom: 1px solid var(--border);
  }

  .hero-card {
    max-width: 100%;
  }

  .hero-main-content {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .hero-header {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .avatar-link {
    display: inline-block;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .hero-avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--border);
    object-fit: cover;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }

  .avatar-link:hover .hero-avatar {
    transform: rotate(6deg) scale(1.05);
    box-shadow: 0 4px 12px color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .hero-title {
    margin: 0;
    font-size: clamp(1.6rem, 3.2vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .hero-title .dot {
    color: var(--accent);
  }

  .hero-bio {
    margin: 0;
    max-width: 820px;
    font-size: 1.03rem;
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .garden-badge {
    display: inline-flex;
    align-items: center;
    padding: 1px 8px;
    border-radius: 6px;
    background: var(--accent-subtle);
    color: var(--accent);
    font-size: 0.9em;
    font-weight: 600;
    vertical-align: baseline;
  }

  .hero-meta-row {
    margin-top: 4px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .hero-status {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .location-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border-radius: 9999px;
    background: var(--bg-muted);
    color: var(--text-secondary);
    font-weight: 500;
  }

  .status-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);
  }

  .status-sep,
  .link-sep {
    color: var(--border-strong);
  }

  .reading-hint {
    color: var(--text-muted);
  }

  .book-link {
    color: var(--text-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .book-link:hover {
    color: var(--accent);
  }

  .hero-links {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .quick-link {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .quick-link:hover {
    color: var(--accent);
  }

  .ask-link {
    color: var(--accent);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .hero-section {
      padding-block: 28px 24px;
    }
    .hero-meta-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    .hero-links {
      width: 100%;
      justify-content: flex-start;
    }
  }
</style>
