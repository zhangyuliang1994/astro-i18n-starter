---
import { Image } from "astro:assets";
import AvatarImage from "@/assets/about-avatar.png";
import { type Lang } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const isEn = locale === "en";
---

<section class="hero-section">
  <!-- Subtle mist mountain silhouette in background -->
  <div class="mist-mountain-bg" aria-hidden="true"></div>

  <div class="hero-container">
    <!-- Left column: Intro & Status -->
    <div class="hero-left">
      <div class="hero-author-row">
        <a href={getRelativeLocaleUrl(locale, "/about")} class="avatar-link" title={isEn ? "About Frency" : "关于作者"}>
          <Image
            src={AvatarImage}
            alt="Frency"
            width={76}
            height={76}
            class="hero-avatar"
            loading="eager"
            fetchpriority="high"
          />
        </a>

        <div class="hero-name-block">
          <div class="hero-greeting">
            <span class="greeting-prefix">{isEn ? "Hello, I'm" : "你好，我是"}</span>
            <span class="hero-name">{isEn ? "Frency" : "晓风"}</span>
            {!isEn && <span class="seal-stamp ml-1.5">字·小峰</span>}
          </div>
          <p class="hero-subtitle">
            {isEn ? "Backend Engineer · Indie Builder · Digital Gardener" : "后端工程师 · 独立出海 · 慢品烟雨与代码"}
          </p>
        </div>
      </div>

      <p class="hero-bio">
        {
          isEn ? (
            <>
              Welcome to my digital garden. Documenting backend system design, indie micro-SaaS explorations, SEO playbooks, and curated book takeaways from Nanjing.
            </>
          ) : (
            <>
              驻扎金陵的后端开发工程师，业余折腾出海工具与独立开发。在这里静心记录系统架构、出海复盘、技术笔记与读书感悟。
            </>
          )
        }
      </p>

      <!-- Meta Row -->
      <div class="hero-meta-row">
        <div class="hero-status">
          <span class="location-pill">
            <span class="status-pulse" aria-hidden="true"></span>
            金陵 · Nanjing
          </span>
          <span class="status-sep">·</span>
          <span class="reading-hint">
            {isEn ? "Reading " : "最近在读 "}
            <a href={getRelativeLocaleUrl(locale, "/books/the-road-less-traveled")} class="book-link">
              《{isEn ? "The Road Less Traveled" : "少有人走的路"}》
            </a>
          </span>
        </div>

        <div class="hero-links">
          <a href={getRelativeLocaleUrl(locale, "/rss.xml")} class="quick-link">RSS</a>
          <span class="link-sep">·</span>
          <a href="https://github.com/psephopaiktes" target="_blank" rel="noopener noreferrer" class="quick-link">GitHub</a>
          <span class="link-sep">·</span>
          <a href={getRelativeLocaleUrl(locale, "/ask")} class="quick-link ask-link">
            {isEn ? "Ask AI" : "AI 问答"} →
          </a>
        </div>
      </div>
    </div>

    <!-- Right column: Poetic vertical scroll (zh-cn) / Ex Libris (en) -->
    <div class="hero-right">
      {isEn ? (
        <div class="ex-libris-card">
          <div class="ex-libris-top">
            <span class="seal-stamp seal-solid text-xs">XF</span>
            <span class="ex-libris-title">DIGITAL GARDEN</span>
          </div>
          <p class="ex-libris-quote">
            “The slow craft of code and thought, cultivating clarity in the digital wilderness.”
          </p>
          <div class="ex-libris-bottom">
            <span>COLLECTION & NOTES</span>
            <span class="font-mono">EST. 2024</span>
          </div>
        </div>
      ) : (
        <div class="vertical-scroll-card">
          <div class="scroll-inner">
            <div class="vertical-verse">
              <span class="verse-line">烟雨入墨，</span>
              <span class="verse-line">慢煮光阴。</span>
              <span class="verse-line">潜心修码，</span>
              <span class="verse-line">且读且行。</span>
            </div>
            <div class="scroll-seal-col">
              <span class="seal-stamp seal-solid text-[12px]">晓风</span>
              <span class="seal-date">岁次丙午</span>
            </div>
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-block: clamp(32px, 4vw, 48px) 32px;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  /* 淡淡水墨远山与烟雨轻染背景 (纯 SVG 矢量远岫) */
  .mist-mountain-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0.12;
    background-image: radial-gradient(ellipse 70% 50% at 85% 20%, var(--accent) 0%, transparent 60%),
      linear-gradient(to bottom, transparent 60%, var(--bg-primary) 100%);
  }

  :root[data-theme="dark"] .mist-mountain-bg,
  html.dark .mist-mountain-bg {
    opacity: 0.06;
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: minmax(0, 1fr) 260px;
      gap: 48px;
    }
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .hero-author-row {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .avatar-link {
    display: inline-block;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .hero-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    object-fit: cover;
    box-shadow: 0 4px 12px rgba(35, 33, 30, 0.08);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }

  .avatar-link:hover .hero-avatar {
    transform: rotate(4deg) scale(1.05);
    box-shadow: 0 6px 16px color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .hero-name-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hero-greeting {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .greeting-prefix {
    font-size: 1.05rem;
    color: var(--text-muted);
  }

  .hero-name {
    font-family: var(--font-title);
    font-size: clamp(1.6rem, 2.8vw, 2.1rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  .hero-subtitle {
    margin: 0;
    font-size: 0.88rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    letter-spacing: -0.01em;
  }

  .hero-bio {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-secondary);
    max-width: 720px;
  }

  .hero-meta-row {
    margin-top: 6px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .hero-status {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .location-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border-radius: var(--radius-small);
    background: var(--bg-muted);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    font-weight: 500;
  }

  .status-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);
  }

  .status-sep,
  .link-sep {
    color: var(--border-strong);
  }

  .reading-hint {
    color: var(--text-muted);
  }

  .book-link {
    color: var(--text-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .book-link:hover {
    color: var(--accent);
  }

  .hero-links {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .quick-link {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .quick-link:hover {
    color: var(--accent);
  }

  .ask-link {
    color: var(--accent);
    font-weight: 600;
  }

  /* Right Column: Scholars' Vertical Verse Scroll */
  .hero-right {
    display: flex;
    justify-content: flex-end;
  }

  .vertical-scroll-card {
    display: inline-flex;
    padding: 20px 22px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-surface);
    box-shadow: 0 2px 8px rgba(35, 33, 30, 0.04);
    position: relative;
  }

  .vertical-scroll-card::before {
    content: "";
    position: absolute;
    inset: 4px;
    border: 1px dashed var(--border);
    border-radius: calc(var(--radius) - 2px);
    pointer-events: none;
    opacity: 0.6;
  }

  .scroll-inner {
    display: flex;
    flex-direction: row-reverse;
    gap: 20px;
    align-items: stretch;
  }

  .vertical-verse {
    writing-mode: vertical-rl;
    text-orientation: upright;
    font-family: var(--font-title);
    font-size: 1.05rem;
    line-height: 2;
    letter-spacing: 0.22em;
    color: var(--text-primary);
  }

  .verse-line {
    display: inline-block;
  }

  .scroll-seal-col {
    writing-mode: vertical-rl;
    text-orientation: upright;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 4px;
  }

  .seal-date {
    font-family: var(--font-title);
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.15em;
  }

  /* Ex Libris Card for English */
  .ex-libris-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    max-width: 260px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-surface);
    box-shadow: 0 2px 8px rgba(35, 33, 30, 0.04);
  }

  .ex-libris-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .ex-libris-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .ex-libris-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-block: 16px;
  }

  .ex-libris-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    border-top: 1px dashed var(--border);
    padding-top: 10px;
  }

  @media (max-width: 1023px) {
    .hero-right {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      padding-block: 24px 20px;
    }
    .hero-avatar {
      width: 54px;
      height: 54px;
    }
    .hero-meta-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    .hero-links {
      width: 100%;
      justify-content: flex-start;
    }
  }
</style>
