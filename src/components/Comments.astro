---
const { lang = "zh-cn" } = Astro.props;
const isEn = lang === "en";
---
<section class="twikoo-wrap" aria-label={isEn ? "Comments" : "评论"}>
  <h2 class="twikoo-title">{isEn ? "Comments" : "评论"}</h2>
  <div id="tcomment" data-lang={isEn ? "en" : "zh-CN"}></div>
</section>
<script is:inline src="https://cdn.jsdelivr.net/npm/twikoo@1.6.44/dist/twikoo.min.js" defer></script>
<script is:inline>
  window.addEventListener("load", function () {
    var el = document.getElementById("tcomment");
    if (!el || !window.twikoo) return;
    twikoo.init({ envId: "https://twikoo.frency.me", el: "#tcomment", path: location.pathname, lang: el.dataset.lang });
  });
</script>
<style is:global>
  .twikoo-wrap { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border, var(--color-border)); }
  .twikoo-title { font-size: 1.15rem; font-weight: 700; margin-bottom: 1rem; color: var(--text-primary); }
  .twikoo-title::before { content: ""; display: inline-block; width: .5em; height: .5em; margin-right: .5em; background: var(--accent); transform: rotate(45deg); vertical-align: middle; }
  #tcomment { --twikoo-accent: var(--accent); color: var(--text-primary); }
  #tcomment .el-button--primary { background-color: var(--accent) !important; border-color: var(--accent) !important; }
  #tcomment a, #tcomment .tk-action-link { color: var(--accent); }
  #tcomment .el-textarea__inner, #tcomment .el-input__inner { background: var(--bg-surface, transparent); color: var(--text-primary); border-color: var(--border); }
  #tcomment .el-textarea__inner:focus, #tcomment .el-input__inner:focus { border-color: var(--accent); }
  #tcomment .tk-meta-input .el-input-group__prepend { background: var(--bg-muted, transparent); color: var(--text-secondary); border-color: var(--border); }
  #tcomment .tk-time, #tcomment .tk-comments-count { color: var(--text-muted); }
</style>
