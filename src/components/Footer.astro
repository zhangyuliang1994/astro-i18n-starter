---
import LocalesHomeList from "@/components/i18n/LocalesHomeList.astro";
import { useTranslations, type Lang } from "@/i18n";
const t = useTranslations(Astro.currentLocale as Lang);
const currentYear = new Date().getFullYear();
const copyrightOwner = t({ en: "frency", "zh-cn": "xiaofeng" });
---

<footer class="site-footer">
  <div class="footer-inner l-content">
    <div class="footer-primary">
      <div class="footer-sign">
        <span class="footer-seal" aria-hidden="true">晓<br />风</span>
        <span class="footer-colophon">{t({ en: "Written slowly, in the misty rain of Nanjing.", "zh-cn": "金陵烟雨中，晓风 谨识", ja: "金陵の霧雨の中で", ar: "Written slowly, in the misty rain of Nanjing." })}</span>
      </div>
      <div class="footer-tagline">
        {t({ ja: "インスピレーションを記録し、思考を沈殿させる", en: "Capture inspiration, cultivate thoughts", "zh-cn": "记录灵感，沉淀思考 · 慢品烟雨与代码", ar: "التقاط الإلهام، زراعة الأفكار" })}
      </div>
      <div class="copy">
        ©2024 - {currentYear} By {copyrightOwner}
      </div>
    </div>
    <div class="footer-secondary">
      <ul class="locale-list"><LocalesHomeList /></ul>
      <div class="icp-info">
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">苏ICP备2023046043号-3</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-surface) 94%, transparent);
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: clamp(32px, 5vw, 64px);
    padding-block: clamp(32px, 4vw, 44px);
  }
  .footer-primary,
  .footer-secondary { display: grid; gap: 12px; }
  .footer-secondary { justify-items: end; text-align: end; }
  .footer-tagline { font-family: var(--font-title); font-size: 0.95rem; font-weight: 600; color: var(--color-main); letter-spacing: 0.02em; }
  .footer-sign { display: flex; align-items: center; gap: 14px; }
  .footer-seal {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; flex-shrink: 0;
    background: var(--accent); color: #fdf8f0;
    font-family: var(--font-title); font-size: 15px; line-height: 1.05; font-weight: 700;
    border-radius: 3px; transform: rotate(-4deg);
    box-shadow: inset 0 0 0 2px var(--accent), inset 0 0 0 3px rgba(255,255,255,.55);
    opacity: .92;
  }
  .footer-colophon { font-family: var(--font-title); color: var(--color-muted); letter-spacing: .1em; font-size: .92rem; }
  .copy,
  .icp-info { color: var(--color-faint); font-family: var(--font-mono); font-size: 0.75rem; }
  .icp-info a:hover { color: var(--color-theme); }
  .locale-list { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px 18px; }
  .locale-list :global(a) {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .locale-list :global(a:hover) { color: var(--color-theme); }
  @media (max-width: 720px) {
    .footer-inner { flex-direction: column; gap: 28px; padding-block: 32px; }
    .footer-secondary { justify-items: start; text-align: start; }
    .locale-list { justify-content: flex-start; }
  }
</style>
