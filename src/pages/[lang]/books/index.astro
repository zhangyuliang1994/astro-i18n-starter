---
import { LOCALES, useTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/Base.astro";
import PageHeadline from "@/components/PageHeadline.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);

const books = (await getCollection("books"))
  .filter((book) => book.id.split("/")[0] === locale)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const title = t({
  en: "Reading Notes",
  "zh-cn": "读书笔记",
  ja: "読書ノート",
  ar: "ملاحظات القراءة",
});

const description = t({
  en: "Curated reading notes, key takeaways, and mental models from books that shaped my thinking.",
  "zh-cn": "输出是最好的输入。记录阅读过的书籍、核心认知模型、金句摘录与实践思考。",
  ja: "思考を形成した書籍の読書メモ、重要なポイント、メンタルモデル。",
  ar: "ملاحظات قراءة منتقاة، ونماذج ذهنية شكلت طريقة تفكيري.",
});

const statusLabels: Record<string, string> = {
  all: t({ en: "All", "zh-cn": "全部", ja: "すべて", ar: "الكل" }),
  recommended: t({ en: "Recommended", "zh-cn": "力荐", ja: "おすすめ", ar: "موصى به" }),
  reading: t({ en: "Reading", "zh-cn": "在读", ja: "読書中", ar: "قيد القراءة" }),
  finished: t({ en: "Finished", "zh-cn": "已读完", ja: "読了", ar: "مكتمل" }),
};

export const getStaticPaths = () =>
  Object.keys(LOCALES).map((lang) => ({
    params: { lang },
  }));
---

<Layout {title} {description}>
  <PageHeadline {title} />
  <p class="page-description">{description}</p>

  <div class="filter-bar" role="tablist" aria-label="Book status filters">
    <button class="filter-btn active" data-filter="all" type="button">
      {statusLabels.all} ({books.length})
    </button>
    <button class="filter-btn" data-filter="recommended" type="button">
      ⭐ {statusLabels.recommended} ({books.filter(b => b.data.status === 'recommended').length})
    </button>
    <button class="filter-btn" data-filter="reading" type="button">
      📖 {statusLabels.reading} ({books.filter(b => b.data.status === 'reading').length})
    </button>
    <button class="filter-btn" data-filter="finished" type="button">
      ✓ {statusLabels.finished} ({books.filter(b => b.data.status === 'finished').length})
    </button>
  </div>

  <!-- 5-column pure 2:3 3D book cover gallery (eliminating large gray box) -->
  <div class="books-grid">
    {
      books.map((book) => {
        const [, ...id] = book.id.split("/");
        return (
          <article class="book-gallery-item" data-status={book.data.status}>
            <a href={`/${locale}/books/${id.join("/")}/`} class="book-gallery-link group">
              <!-- 2:3 3D Book Cover -->
              <div class="book-cover-3d relative aspect-[2/3] w-full overflow-hidden bg-[var(--bg-muted)] transition-transform duration-300 group-hover:-translate-y-2">
                {book.data.cover && (
                  <Image
                    src={book.data.cover}
                    alt={book.data.title}
                    class="h-full w-full object-cover"
                    width={320}
                    height={480}
                    loading="lazy"
                  />
                )}
                {book.data.rating ? (
                  <span class="absolute top-2 right-2 rounded-full bg-black/60 backdrop-blur-md px-2 py-0.5 font-mono-tabular text-[11px] font-semibold text-white shadow-sm">
                    ★ {book.data.rating.toFixed(1)}
                  </span>
                ) : (
                  <span class="absolute top-2 right-2 rounded-full bg-black/50 backdrop-blur-md px-2 py-0.5 font-mono-tabular text-[11px] text-white/90">
                    {book.data.status === "reading" ? "在读" : "已读"}
                  </span>
                )}
              </div>

              <!-- Metadata directly below cover -->
              <div class="book-info">
                <h2 class="book-title group-hover:text-[var(--accent)] transition-colors">
                  {book.data.title}
                </h2>
                {book.data.author && <p class="book-author">{book.data.author}</p>}
                <div class="book-status-row">
                  <span class="book-status-dot" data-status={book.data.status}></span>
                  <span class="book-status-text">
                    {book.data.status === "recommended" && statusLabels.recommended}
                    {book.data.status === "reading" && statusLabels.reading}
                    {book.data.status === "finished" && statusLabels.finished}
                  </span>
                </div>
              </div>
            </a>
          </article>
        );
      })
    }
  </div>
</Layout>

<script>
  function setupFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const cards = document.querySelectorAll<HTMLElement>(".book-gallery-item");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        buttons.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");

        const filter = btn.dataset.filter;
        cards.forEach((card) => {
          if (filter === "all" || card.dataset.status === filter) {
            card.style.display = "";
          } else {
            card.style.display = "none";
          }
        });
      });
    });
  }

  setupFilters();
  document.addEventListener("astro:page-load", setupFilters);
</script>

<style>
  .page-description {
    color: var(--text-secondary);
    margin-block: var(--sp-s) var(--sp-m);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 720px;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-block-end: var(--sp-l);
  }

  .filter-btn {
    appearance: none;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-small);
    padding: 5px 14px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .filter-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #ffffff;
  }

  .books-grid {
    display: grid;
    gap: 32px 24px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-block-end: var(--sp-xl);
  }

  @media (min-width: 640px) {
    .books-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 860px) {
    .books-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .books-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .book-gallery-item {
    height: 100%;
  }

  .book-gallery-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .book-info {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .book-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.35;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .book-author {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-family: var(--font-sans);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .book-status-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .book-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-muted);
  }

  .book-status-dot[data-status="recommended"] {
    background: var(--accent);
  }

  .book-status-dot[data-status="reading"] {
    background: #10b981;
  }
</style>
