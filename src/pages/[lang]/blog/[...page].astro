---
import { LOCALES, useTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/Base.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import PageHeadline from "@/components/PageHeadline.astro";
import Pagination from "@/components/Pagination.astro";
import type { GetStaticPaths } from "astro";
import { getTraditionalDateLabel } from "@/utils/lunar";

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getCollection("blog");
  
  return Object.keys(LOCALES).flatMap((lang) => {
    const posts = allPosts
      .filter((post) => post.id.split("/")[0] === lang)
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
    
    return paginate(posts, {
      params: { lang },
      pageSize: 10,
    });
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const locale = Astro.params.lang as Lang;
const t = useTranslations(locale);

const title = t({
  ja: "ブログ",
  en: "Blog",
  "zh-cn": "博客",
  ar: "مدونة",
});

const pageTitle = page.currentPage > 1 
  ? `${title} - ${t({ ja: "ページ", en: "Page", "zh-cn": "第", ar: "صفحة" })} ${page.currentPage}`
  : title;

const description = t({
  en: "Technical notes, SEO strategies, and practical lessons from building products for global markets.",
  "zh-cn": "分享技术难题、SEO 策略，以及出海建站的实践经验。",
});
---

<Layout title={pageTitle} {description}>
  <PageHeadline {title} />

  <p class="archive-description">
    {description}
  </p>

  <ul class="blog-list">
    {
      page.data.map((post, idx) => {
        const [, ...id] = post.id.split("/");
        return (
          <li>
            <a href={`/${locale}/blog/${id.join("/")}/`} class="blog-row group">
              {post.data.cover && (
                <div class="blog-cover">
                  <Image
                    src={post.data.cover}
                    alt={post.data.title}
                    width={480}
                    height={270}
                    loading={idx === 0 ? "eager" : "lazy"}
                    fetchpriority={idx === 0 ? "high" : "auto"}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  />
                </div>
              )}
              <div class="blog-copy">
                <div class="meta-line">
                  <time datetime={post.data.date.toISOString()}>
                    {getTraditionalDateLabel(post.data.date, locale === "en")}
                  </time>
                  {post.data.categories?.[0] && (
                    <span class="category-pill">#{post.data.categories[0]}</span>
                  )}
                </div>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </div>
            </a>
          </li>
        );
      })
    }
  </ul>

  <Pagination page={page} lang={locale} />
</Layout>

<style>
  .archive-description {
    margin-block-start: var(--sp-s);
    color: var(--text-secondary);
    font-size: 1.05rem;
    max-width: 720px;
    line-height: 1.7;
  }

  .blog-list {
    margin-block-start: var(--sp-m);
    display: grid;
    gap: 0;
    max-width: 1120px;
    list-style: none;
    padding: 0;
  }

  li {
    border-bottom: 1px solid var(--border);
  }

  .blog-row {
    display: grid;
    grid-template-columns: minmax(220px, 32%) minmax(0, 1fr);
    gap: clamp(20px, 3vw, 36px);
    padding-block: clamp(22px, 3vw, 32px);
    color: inherit;
    text-decoration: none;
  }

  .blog-row:hover h2 {
    color: var(--accent);
  }

  .blog-cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--bg-muted);
    border: 1px solid var(--border);
  }

  .blog-copy {
    align-self: center;
    min-width: 0;
  }

  .meta-line {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .category-pill {
    padding: 1px 7px;
    border-radius: var(--radius-small);
    background: var(--bg-muted);
    color: var(--text-secondary);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .blog-copy h2 {
    margin-top: 8px;
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.38;
    transition: color 0.2s ease;
  }

  .blog-copy p {
    margin-top: 8px;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .blog-row {
      grid-template-columns: 1fr;
      gap: 16px;
      padding-block: 20px;
    }
    .blog-copy h2 {
      font-size: 1.25rem;
    }
  }
</style>
