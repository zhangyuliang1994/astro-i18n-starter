---
import Layout from "@/layouts/PostLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => {
    const [lang, ...id] = post.id.split("/");
    return { params: { lang, id: id.join("/") || undefined }, props: post };
  });
}

const { lang } = Astro.params;
const post = Astro.props;

const { Content, headings } = await render(post);
const title = post.data.title;
const description = post.data.description;

// Estimate reading time from content
const wordCount = (post.body || "").length;
const readMinutes = Math.max(1, Math.ceil(wordCount / 350));
const readingTime = lang === "en" ? `${readMinutes} min read` : `约 ${readMinutes} 分钟阅读`;
---

<Layout
  title={title}
  description={description}
  pubDate={post.data.date}
  category={post.data.categories?.[0]}
  tags={post.data.tags}
  cover={post.data.cover}
  headings={headings}
  readingTime={readingTime}
>
  <Content />
</Layout>
