---
import { LOCALES, useTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/Base.astro";
import Hero from "@/components/Hero.astro";
import PostCard from "@/components/PostCard.astro";
import BookshelfSection from "@/components/BookshelfSection.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);

const posts = (await getCollection("blog"))
  .filter((post) => post.id.split("/")[0] === locale)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

const books = (await getCollection("books"))
  .filter((book) => book.id.split("/")[0] === locale)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

export const getStaticPaths = () =>
  Object.keys(LOCALES).map((lang) => ({
    params: { lang },
  }));
---

<Layout isHome={true}>
  <Hero locale={locale} />

  <!-- Latest Posts -->
  <section class="mt-12 sm:mt-14">
    <div class="mb-6 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <span class="h-5 w-1.5 rounded-full bg-[var(--accent)]"></span>
        <h2 class="text-[22px] font-bold tracking-tight text-[var(--text-primary)]">
          {t({ en: "Latest Posts", "zh-cn": "最新文章", ja: "最新の投稿", ar: "أحدث المشاركات" })}
        </h2>
        <span class="font-mono-tabular text-[14px] text-[var(--text-muted)]">(Articles)</span>
      </div>
      <a
        href={getRelativeLocaleUrl(locale, "/blog")}
        class="group inline-flex items-center gap-1.5 rounded-full bg-[var(--bg-muted)] px-4 py-1.5 text-[14.5px] font-medium text-[var(--text-primary)] hover:bg-[var(--accent-subtle)] hover:text-[var(--accent)] transition-all"
      >
        <span>{t({ en: "View All", "zh-cn": "查看全部", ja: "すべて見る", ar: "عرض الكل" })}</span>
        <span class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post, idx) => {
          const [, ...id] = post.id.split("/");
          return (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.date.toLocaleDateString(locale)}
              category={post.data.categories?.[0]}
              cover={post.data.cover}
              href={getRelativeLocaleUrl(locale, `/blog/${id.join("/")}/`)}
              eager={idx < 3}
            />
          );
        })
      }
    </div>
  </section>

  <!-- Bookshelf Section -->
  {books.length > 0 && <BookshelfSection books={books} locale={locale} />}

  <!-- Quick Navigation Links -->
  <section class="mt-14 mb-8">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <a href={getRelativeLocaleUrl(locale, "/categories")} class="quick-link-card">
        <span class="material-icons-sharp icon">category</span>
        <div class="quick-text">
          <span class="quick-title">{t({ en: "Categories", "zh-cn": "全站分类", ja: "カテゴリー", ar: "التصنيفات" })}</span>
          <span class="quick-desc">{t({ en: "Explore by topic", "zh-cn": "按知识体系浏览", ja: "トピック別", ar: "تصفح حسب الموضوع" })}</span>
        </div>
      </a>
      <a href={getRelativeLocaleUrl(locale, "/tags")} class="quick-link-card">
        <span class="material-icons-sharp icon">label</span>
        <div class="quick-text">
          <span class="quick-title">{t({ en: "Tags", "zh-cn": "标签图谱", ja: "タグ", ar: "الوسوم" })}</span>
          <span class="quick-desc">{t({ en: "Filter content quickly", "zh-cn": "细粒度快速检索", ja: "クイック検索", ar: "البحث بالوسوم" })}</span>
        </div>
      </a>
      <a href={getRelativeLocaleUrl(locale, "/about")} class="quick-link-card">
        <span class="material-icons-sharp icon">person</span>
        <div class="quick-text">
          <span class="quick-title">{t({ en: "About Me", "zh-cn": "关于作者", ja: "プロフィール", ar: "حول" })}</span>
          <span class="quick-desc">{t({ en: "Background & career", "zh-cn": "技术栈与经历", ja: "経歴・スキル", ar: "نبذة عني" })}</span>
        </div>
      </a>
    </div>
  </section>
</Layout>

<style>
  .quick-link-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 22px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text-primary);
    transition: all 0.2s ease;
  }

  .quick-link-card:hover {
    border-color: var(--accent);
    background: var(--bg-surface);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
  }

  .quick-link-card:hover .icon {
    color: var(--accent);
    transform: scale(1.1);
  }

  .quick-link-card .icon {
    font-size: 2rem;
    color: var(--text-muted);
    transition: transform 0.2s ease, color 0.2s ease;
    flex-shrink: 0;
  }

  .quick-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .quick-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .quick-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>
