---
import { LOCALES, useTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/Base.astro";
import Hero from "@/components/Hero.astro";
import PostCard from "@/components/PostCard.astro";
import BookshelfSection from "@/components/BookshelfSection.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);

const posts = (await getCollection("blog"))
  .filter((post) => post.id.split("/")[0] === locale)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

const books = (await getCollection("books"))
  .filter((book) => book.id.split("/")[0] === locale)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

export const getStaticPaths = () =>
  Object.keys(LOCALES).map((lang) => ({
    params: { lang },
  }));
---

<Layout isHome={true}>
  <Hero locale={locale} />

  <!-- Latest Posts -->
  <section class="mt-12 sm:mt-14">
    <div class="mb-6 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <span class="sec-seal" aria-hidden="true"></span>
        <h2 class="font-title text-[22px] font-bold tracking-normal text-[var(--text-primary)]">
          {t({ en: "Latest Posts", "zh-cn": "最新文章", ja: "最新の投稿", ar: "أحدث المشاركات" })}
        </h2>
        <span class="font-mono-tabular text-[13.5px] text-[var(--text-muted)]">(Articles)</span>
      </div>
      <a
        href={getRelativeLocaleUrl(locale, "/blog")}
        class="group inline-flex items-center gap-1.5 rounded-[var(--radius-small)] border border-[var(--border)] bg-[var(--bg-surface)] px-3.5 py-1 text-[13.5px] font-medium text-[var(--text-secondary)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-all"
      >
        <span>{t({ en: "View All", "zh-cn": "查看全部", ja: "すべて見る", ar: "عرض الكل" })}</span>
        <span class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post, idx) => {
          const [, ...id] = post.id.split("/");
          return (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.date.toLocaleDateString(locale)}
              category={post.data.categories?.[0]}
              cover={post.data.cover}
              href={getRelativeLocaleUrl(locale, `/blog/${id.join("/")}/`)}
              eager={idx < 3}
            />
          );
        })
      }
    </div>
  </section>

  <!-- Bookshelf Section -->
  {books.length > 0 && <BookshelfSection books={books} locale={locale} />}

  <!-- Quiet text navigation -->
  <nav class="ink-nav" aria-label="Site sections">
    <a href={getRelativeLocaleUrl(locale, "/categories")}>{t({ en: "Categories", "zh-cn": "全站分类", ja: "カテゴリー", ar: "التصنيفات" })}</a>
    <span aria-hidden="true">·</span>
    <a href={getRelativeLocaleUrl(locale, "/tags")}>{t({ en: "Tags", "zh-cn": "标签图谱", ja: "タグ", ar: "الوسوم" })}</a>
    <span aria-hidden="true">·</span>
    <a href={getRelativeLocaleUrl(locale, "/about")}>{t({ en: "About Me", "zh-cn": "关于作者", ja: "プロフィール", ar: "حول" })}</a>
  </nav>
</Layout>

<style>
  .ink-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 18px;
    margin-block: 64px 24px;
    padding-top: 28px;
    font-family: var(--font-title);
    font-size: 1.02rem;
    letter-spacing: 0.12em;
    color: var(--text-muted);
  }
  .ink-nav a { color: var(--text-secondary); text-decoration: none; }
  .ink-nav a:hover { color: var(--accent); }
</style>
